{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/notifications/telegram/dispatch",
      "schedule": "*/10 * * * *"
    }
  ],
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "scraper",
          "format": "url",
          "env": "SCRAPER_SERVICE_URL"
        }
      ]
    },
    "scraper": {
      "root": "services/scraper",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
